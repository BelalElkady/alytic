<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. "development" here; the App Store distribution profile
	     switches it to "production" when you archive (docs/ios-release.md). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: needs https://egxpert.com/.well-known/apple-app-site-association (docs/deep-links.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:egxpert.com</string>
		<string>applinks:www.egxpert.com</string>
	</array>
</dict>
</plist>
