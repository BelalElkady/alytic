# اختياري — تسجيل الدخول بجوجل. لازم تكون نفس قيمة GOOGLE_CLIENT_ID في backend/.env
# VITE_GOOGLE_CLIENT_ID=

# اختياري — رابط باك-إند Alytic (Express) اللي بروكسي /api/public بيوجّه له
# ALYTIC_API_URL=http://localhost:3000

# اختياري — للسماح بمعاينة Lovable داخل iframe. بيعيد إصدار كوكي الجلسة بـ SameSite=None
# وده بيضعف الحماية من الطلبات عبر المواقع، فسيبه فاضي على الموقع الحقيقي.
# ALLOW_LOVABLE_PREVIEW=1

# ---- Native apps (Capacitor) — see docs/mobile-environment.md -------------
# Everything VITE_* is inlined into the app bundle and is PUBLIC. No secrets here, ever.
# Copy env/mobile.production.env (or .development / .staging) to .env.production.local
# or export the variables before running `bun run build:mobile`.
# VITE_APP_ENV=production
# VITE_SITE_URL=https://egxpert.com
# VITE_API_BASE_URL=https://egxpert.com/api/public
# VITE_LINK_HOSTS=egxpert.com,www.egxpert.com
# VITE_URL_SCHEME=egxpert
# VITE_APP_VERSION=1.0.0
# CAP_APP_ID=com.egxpert.app
# CAP_APP_NAME=EGXpert
# Dev only (ignored when VITE_APP_ENV=production): live reload from a dev server on your LAN
# CAP_DEV_SERVER_URL=http://192.168.1.20:8080
#
# Server side (proxy + backend), not bundled: MOBILE_ORIGINS=capacitor://localhost,https://localhost
