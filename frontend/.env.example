# اختياري — تسجيل الدخول بجوجل. لازم تكون نفس قيمة GOOGLE_CLIENT_ID في backend/.env
# VITE_GOOGLE_CLIENT_ID=

# اختياري — رابط باك-إند Alytic (Express) اللي بروكسي /api/public بيوجّه له
# ALYTIC_API_URL=http://localhost:3000

# اختياري — للسماح بمعاينة Lovable داخل iframe. بيعيد إصدار كوكي الجلسة بـ SameSite=None
# وده بيضعف الحماية من الطلبات عبر المواقع، فسيبه فاضي على الموقع الحقيقي.
# ALLOW_LOVABLE_PREVIEW=1
