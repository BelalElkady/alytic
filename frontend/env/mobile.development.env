# Development builds may talk to a local backend over http (never allowed for production).
# 10.0.2.2 is the Android emulator's alias for the host machine; use your LAN IP on a device.
VITE_APP_ENV=development
VITE_SITE_URL=https://egxpert.com
VITE_API_BASE_URL=http://10.0.2.2:8080/api/public
VITE_LINK_HOSTS=egxpert.com
VITE_URL_SCHEME=egxpert-dev
