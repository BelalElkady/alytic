{
  "name": "EGXpert — WhatsApp lifecycle",
  "nodes": [
    {
      "parameters": {
        "content": "## EGXpert WhatsApp lifecycle\nThe backend decides who gets which step and builds the Graph API body. This workflow only delivers and reports back.\n\n**Before activating** (see automation/n8n/README.md):\n1. Replace `REPLACE_PHONE_NUMBER_ID` in *Send Template* and *Send Reply*.\n2. Attach the three credentials.\n3. Copy the *Event Webhook* production URL into the backend's `N8N_WHATSAPP_WEBHOOK_URL`.",
        "height": 300,
        "width": 420
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a01",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -380]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alytic-whatsapp-event",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a02",
      "name": "Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [440, -160],
      "webhookId": "5f0c1c9e-7a4b-4c55-8f8e-2f6d1b7a9e11",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE", "name": "Alytic automation secret" }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a03",
      "name": "Every 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 60]
    },
    {
      "parameters": {
        "url": "https://egxpert.com/api/automation/whatsapp/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a04",
      "name": "Fetch Due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 60],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE", "name": "Alytic automation secret" }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a05",
      "name": "Split Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 60]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1d5c0e2-0f43-4c6b-b1a8-6a1f6e2d3c01",
              "name": "messageId",
              "value": "={{ $json.messageId ?? $json.body.messageId }}",
              "type": "string"
            },
            {
              "id": "a1d5c0e2-0f43-4c6b-b1a8-6a1f6e2d3c02",
              "name": "request",
              "value": "={{ $json.request ?? $json.body.request }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a06",
      "name": "Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/REPLACE_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "batching": { "batch": { "batchSize": 1, "batchInterval": 1000 } }
        }
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a07",
      "name": "Send Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -40],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE", "name": "WhatsApp Cloud API token" }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns Meta's answer (or the error n8n kept going past) into the\n// /result body. The messageId comes from the Message node, since the\n// HTTP response replaced this item's JSON.\nconst messageId = $('Message').item.json.messageId;\nconst metaMessageId = $json.messages?.[0]?.id;\nif (metaMessageId) {\n  return { json: { messageId, status: 'sent', metaMessageId } };\n}\nconst error = $json.error?.message ?? $json.error ?? 'no message id in the Graph API response';\nreturn { json: { messageId, status: 'failed', error: String(typeof error === 'string' ? error : JSON.stringify(error)).slice(0, 500) } };"
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a08",
      "name": "Build Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://egxpert.com/api/automation/whatsapp/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a09",
      "name": "Report Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -40],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE", "name": "Alytic automation secret" }
      }
    },
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a10",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [0, 360],
      "webhookId": "9c3e7b2d-1a6f-4e08-b5d4-3f2a8c6e1d22",
      "credentials": {
        "whatsAppTriggerApi": { "id": "REPLACE", "name": "WhatsApp app (trigger)" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Reshapes Meta's webhook into one item per event, in the shape\n// POST /api/automation/whatsapp/events expects. Handles both the raw\n// envelope (entry[].changes[].value) and an already-unwrapped value.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const values = Array.isArray(j.entry)\n    ? j.entry.flatMap((e) => (e.changes ?? []).map((c) => c.value))\n    : [j];\n  for (const v of values) {\n    for (const s of v?.statuses ?? []) {\n      out.push({ json: {\n        type: 'status',\n        metaMessageId: s.id,\n        status: s.status,\n        at: new Date(Number(s.timestamp) * 1000).toISOString(),\n        error: s.errors?.[0]?.title ?? null,\n      } });\n    }\n    for (const m of v?.messages ?? []) {\n      const text = m.text?.body ?? m.button?.text ?? m.interactive?.button_reply?.title ?? '';\n      out.push({ json: { type: 'message', from: `+${m.from}`, metaMessageId: m.id, text } });\n    }\n  }\n}\nreturn out;"
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a11",
      "name": "Parse Meta Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://egxpert.com/api/automation/whatsapp/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a12",
      "name": "Report Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 360],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE", "name": "Alytic automation secret" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c7e1a2b3-5d4f-4e6a-9b8c-0d1e2f3a4b01",
              "leftValue": "={{ $json.reply?.text ?? '' }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a13",
      "name": "Has Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/REPLACE_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.reply.to, type: 'text', text: { body: $json.reply.text } }) }}",
        "options": {}
      },
      "id": "0b7f2a51-4d0e-4b43-9a7e-0d3c8d1f0a14",
      "name": "Send Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 340],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE", "name": "WhatsApp Cloud API token" }
      }
    }
  ],
  "connections": {
    "Event Webhook": {
      "main": [[{ "node": "Message", "type": "main", "index": 0 }]]
    },
