{
  "name": "alytic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EGX stock analyzer — technical + fundamental engine with an AI analyst layer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node --import ./src/instrument.js src/api/server.js",
    "sync": "node src/cli.js sync",
    "analyze": "node src/cli.js analyze",
    "scan": "node src/cli.js scan",
    "review": "node src/cli.js review",
    "verify:universe": "node scripts/verify-universe.js",
    "build:universe": "node scripts/build-universe.js",
    "test": "node scripts/run-tests.mjs \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:api": "node scripts/run-tests.mjs \"test/api/*.test.js\"",
    "cleanup:test-data": "node scripts/cleanup-test-data.js",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "nodemailer": "^10.1.7",
    "openai": "^7.38.0",
    "sanitize-html": "^2.18.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
