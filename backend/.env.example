# بيانات مشروع Supabase — لازمة لتشغيل الخادم (بيانات المستخدمين، المحافظ،
# تقارير السوق، تعديلات المؤشرات). من Project Settings → API في لوحة Supabase.
# SUPABASE_SERVICE_ROLE_KEY سر كامل الصلاحيات — متحطوش في الفرونت إند أبدًا.
# طبّق backend/supabase/schema.sql على المشروع قبل أول تشغيل.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# مفتاح OpenRouter API — لازم للمراجعة الذكية، استيراد صور المحافظ، وجمع البيانات الأساسية.
# التحليل الفني كله (المؤشرات، الوقف، الأهداف، التقييم) بيشتغل من غيره.
# احصل على مفتاح من https://openrouter.ai/keys
OPENROUTER_API_KEY=

# اختياري — تغيير النموذج
# ALYTIC_MODEL=anthropic/claude-sonnet-4
# ALYTIC_FAST_MODEL=anthropic/claude-3.5-haiku
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Alytic

# بديل اختياري لو هتستخدم Anthropic مباشرة بدل OpenRouter
# ANTHROPIC_API_KEY=

# اختياري — بورت الخادم
# PORT=3000

# اختياري — رابط واجهة EGXpert (frontend/) اللي / بيحوّل ليها
# FRONTEND_URL=http://localhost:8080

# سر توقيع جلسة الدخول (كوكي الجلسة) — لازم قيمة عشوائية طويلة في الإنتاج
# SESSION_SECRET=

# اختياري — رابط الواجهة الأمامية المستخدَم في روابط تفعيل البريد الإلكتروني
# (لو مختلف عن FRONTEND_URL)
# APP_URL=http://localhost:8080

# اختياري — تفعيل تسجيل الدخول بجوجل. Client ID من Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → Web application).
# لازم يتحط نفس القيمة في frontend/.env كـ VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=

# إيميلات تتحول لمشرف (admin) تلقائيًا أول ما تعمل حساب (تسجيل عادي أو جوجل) —
# مفصولة بفاصلة. الافتراضي لو المتغير مش موجود: belal.elkady4@gmail.com
# ADMIN_EMAILS=someone@example.com,another@example.com
