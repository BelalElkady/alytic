# بيانات مشروع Supabase — لازمة لتشغيل الخادم (بيانات المستخدمين، المحافظ،
# تقارير السوق، تعديلات المؤشرات). من Project Settings → API في لوحة Supabase.
# SUPABASE_SERVICE_ROLE_KEY سر كامل الصلاحيات — متحطوش في الفرونت إند أبدًا.
# طبّق backend/supabase/schema.sql على المشروع قبل أول تشغيل.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# مفتاح OpenRouter API — لازم للمراجعة الذكية، استيراد صور المحافظ، وجمع البيانات الأساسية.
# التحليل الفني كله (المؤشرات، الوقف، الأهداف، التقييم) بيشتغل من غيره.
# احصل على مفتاح من https://openrouter.ai/keys
OPENROUTER_API_KEY=

# اختياري — تغيير النموذج (كل تحليل نصي: المراجعة، تقرير السوق، البيانات الأساسية)
# ALYTIC_MODEL=anthropic/claude-sonnet-4

# اختياري — موديل مجاني يتجرّب الأول قبل ALYTIC_MODEL. لو السعة المجانية مشغولة
# أو فيه rate limit فضل موجود بعد إعادة المحاولة، الكود بيرجع تلقائيًا لـ
# ALYTIC_MODEL المدفوع لنفس الطلب من غير ما يفشل. سيبه فاضي لإلغاء الفكرة.
# ALYTIC_MODEL_FREE=nvidia/nemotron-3-super-120b-a12b:free

# اختياري — يخلي الموديل يفكر قبل ما يحكم، في مرحلة البحث والتحليل بس
# (مرحلة تنسيق الـ JSON بتفضل من غير تفكير). القيم: minimal / low / medium / high.
# سيبه فاضي عشان التفكير يفضل مقفول. low على deepseek-v4-flash زوّد ~300 token
# و~1.3 ثانية للطلب؛ medium ~560 token و~7 ثواني.
# ALYTIC_REASONING_EFFORT=low

# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Alytic

# اختياري — استيراد صور المحافظ محتاج موديل يفهم صور تحديدًا؛ منفصل عن
# ALYTIC_MODEL فوق عشان تغييره متأثرش على استيراد الصور
# ALYTIC_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# بديل اختياري لو هتستخدم Anthropic مباشرة بدل OpenRouter
# ANTHROPIC_API_KEY=

# اختياري — بورت الخادم
# PORT=3000

# اختياري — رابط واجهة EGXpert (frontend/) اللي / بيحوّل ليها
# FRONTEND_URL=http://localhost:8080

# سر توقيع جلسة الدخول (كوكي الجلسة) — لازم قيمة عشوائية طويلة في الإنتاج
# SESSION_SECRET=

# اختياري — رابط الواجهة الأمامية المستخدَم في روابط تفعيل البريد الإلكتروني
# (لو مختلف عن FRONTEND_URL)
# APP_URL=http://localhost:8080

# اختياري — تفعيل تسجيل الدخول بجوجل. Client ID من Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → Web application).
# لازم يتحط نفس القيمة في frontend/.env كـ VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=

# إيميلات تتحول لمشرف (admin) تلقائيًا أول ما تعمل حساب (تسجيل عادي أو جوجل) —
# مفصولة بفاصلة. الافتراضي لو المتغير مش موجود: belal.elkady4@gmail.com
# ADMIN_EMAILS=someone@example.com,another@example.com

# إيميلات تتحول لمسوّق (marketer) أول ما تعمل حساب — بيشوفوا جدول المستخدمين
# في لوحة الإدارة للقراءة بس (من غير أي تعديل أو حذف) ومفيش غيره. مفصولة بفاصلة.
# لحساب موجود بالفعل: node scripts/make-marketer.mjs someone@example.com
# MARKETER_EMAILS=someone@example.com

# اختياري — الإيميل اللي رسايل نموذج "تواصل معنا" العام بتوصله.
# الافتراضي لو المتغير مش موجود: info@egxpert.com
# CONTACT_EMAIL=someone@example.com

# اختياري — الإيميل اللي إشعارات رسايل الشات بتوصله.
# الافتراضي لو المتغير مش موجود: belal.elkady4@gmail.com
# SUPPORT_NOTIFY_EMAIL=someone@example.com

# إرسال إيميلات تفعيل البريد وإعادة تعيين كلمة السر وتأكيد التسجيل عبر Resend
# (SMTP relay: https://resend.com/docs/send-with-smtp). من غير RESEND_API_KEY
# بيتسجل الرابط في الـ console بس زي قبل كده (نفس سلوك الاختبارات).
# EMAIL_FROM لازم يكون دومين متحقق منه في حساب Resend.
# RESEND_API_KEY=
# EMAIL_FROM=EGXpert <noreply@yourdomain.com>
# اختياري — نادرًا ما يتغيروا
# RESEND_SMTP_HOST=smtp.resend.com
# RESEND_SMTP_PORT=465

# ---- الاشتراك (تحويل InstaPay يدوي) ----
# مفيش بوابة دفع. بوت الشات هو اللي بيدّي بيانات التحويل دي، ولمستخدم مسجّل
# دخوله بس — مش منشورة في أي صفحة ولا في /api/billing/plans العام. بعد ما
# التحويل يوصل، المشرف بيفعّل الاشتراك من لوحة الإدارة (المستخدمين → تفعيل).
# من غير INSTAPAY_ADDRESS البوت بيقول للمستخدم إن حد مننا هيبعتله التفاصيل.
# INSTAPAY_ADDRESS=https://ipn.eg/S/your-handle/instapay/xxxxxx   # لينك الدفع — اختياري، فيه لينك افتراضي. بيظهر في زرار "عشان تدفع دوس هنا"
# INSTAPAY_ACCOUNT_NAME=الاسم اللي هيظهر للمستخدم
#
# إشعارات رسايل الشات بتروح على SUPPORT_NOTIFY_EMAIL فوق.

# ---- الأمان ----
# مصادر إضافية (مفصولة بفاصلة) مسموح لها تبعت طلبات كتابة (POST/PUT/PATCH/DELETE)
# من المتصفح. المسموح تلقائيًا: FRONTEND_URL و APP_URL (مع نسخة www/بدون www)
# و https://egxpert.com. أي طلب كتابة من موقع تاني بيتقفل بـ 403.
# ALLOWED_ORIGINS=https://staging.example.com
#
# أسرار الـ cron — كل واحد قيمة عشوائية مختلفة (32 حرف على الأقل): openssl rand -hex 32
# BLOG_CRON_SECRET=
# STOP_PLAN_CRON_SECRET=
# DAILY_CLOSE_CRON_SECRET=
#
# للتحقق من الإعدادات: npm run security:check   (أو مع رابط الموقع للفحص الحي)

# ---- White-label (عملاء بمواقع خاصة بيهم) ----------------------------------
# المفتاح اللي بيتشفّر بيه مفتاح Supabase بتاع كل عميل قبل ما يتحفظ في جدول tenants.
# 64 حرف hex: openssl rand -hex 32 — لو ضاع لازم تدخّل مفاتيح كل العملاء تاني.
# مش لازم غير لما تضيف أول عميل. طبّق backend/supabase/platform.sql الأول.
# TENANT_SECRETS_KEY=

# الإيميلات اللي تقدر تفتح لوحة إدارة العملاء (/api/platform). الافتراضي ADMIN_EMAILS.
# PLATFORM_ADMIN_EMAILS=

# اسم الموقع الأساسي في جدول tenants (الافتراضي egxpert)
# DEFAULT_TENANT_ID=egxpert

# اختياري — أسعار لحظية للمشتركين من oanor بدل TradingView (المتأخر حوالي ١٥ دقيقة).
# التصميم كامل في docs/adr/0001-live-prices-for-subscribers-via-oanor.md.
# من غير OANOR_ENABLED=1 كل الناس على TradingView زي الأول.
# OANOR_ENABLED=1
# OANOR_API_KEY=
# الحصة الشهرية لباقة oanor (عدد الطلبات). عند ٩٥٪ منها المشتركين بيرجعوا لـ
# TradingView لحد ما الحصة تتجدد، من غير ما حد يحس. بيظهر بس في تبويب "الأسعار اللحظية" في لوحة الإدارة.
# OANOR_MONTHLY_QUOTA=
# يوم الشهر اللي الحصة بتتجدد فيه (١–٢٨، الافتراضي ١).
# OANOR_BILLING_DAY=1
# عدد الطلبات المسموح في الثانية حسب الباقة: Free 2، Basic 10، Pro 20، Scale 50 (الافتراضي 2).
# OANOR_RATE_PER_SEC=2
# مرحلة التجربة: لو متحدد، المشتركين اللي في القايمة دي بس (IDs مفصولة بفاصلة) هم اللي ياخدوا oanor.
# oanor للمشتركين بس ووقت جلسة البورصة بس (١٠:٠٠–١٤:٣٠ بتوقيت القاهرة)، وغير كده TradingView.
# OANOR_USER_IDS=
# مرحلة التجربة: يقارن سعر oanor بـ TradingView لكل سهم ويعرض الفرق في تبويب "الأسعار اللحظية". اقفله بعدها.
# OANOR_COMPARE=1
